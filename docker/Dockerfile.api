# ─────────────────────────────────────────────
# XartIA API image
# Запускается через tsx (без compile-стадии) — см. package.json engines.
# ─────────────────────────────────────────────
FROM node:22-alpine AS runtime

# tini — PID 1; psql/redis-cli — для entrypoint wait-хелперов
RUN apk add --no-cache tini wget postgresql-client redis

# pnpm 9 — соответствует package.json
RUN corepack enable && corepack prepare pnpm@9 --activate

WORKDIR /app

# Non-root user
RUN addgroup -S app && adduser -S app -G app

# Prod-зависимости
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod && pnpm store prune

# Исходники, миграции, скрипты
COPY --chown=app:app tsconfig.json tsconfig.base.json ./
COPY --chown=app:app src       ./src
COPY --chown=app:app db        ./db
COPY --chown=app:app scripts   ./scripts

# Entrypoint
COPY --chown=app:app docker/entrypoint.sh /app/entrypoint.sh
RUN sed -i 's/\r$//' /app/entrypoint.sh && chmod +x /app/entrypoint.sh

# Страховка от CRLF в entrypoint — если он скрипт из Windows-среды
RUN sed -i 's/\r$//' /app/entrypoint.sh && chmod +x /app/entrypoint.sh

USER app

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
  CMD wget -qO- http://localhost:3000/health/live || exit 1

ENTRYPOINT ["/sbin/tini", "--", "/app/entrypoint.sh"]
CMD ["node_modules/.bin/tsx", "src/server.ts"]
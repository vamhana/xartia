# ─── Runtime ───────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ─── API ───────────────────────────────────────
API_PORT=3000
API_URL=http://localhost:3000

# ─── WebSocket ─────────────────────────────────
WS_PORT=3001
WS_URL=ws://localhost:3001/ws

# ─── Database ──────────────────────────────────
DATABASE_URL=postgresql://charter:charter@localhost:5432/charter
DATABASE_REPLICA_URL=postgresql://charter:charter@localhost:5432/charter
DB_POOL_SIZE=20
DB_REPLICA_POOL_SIZE=10

# ─── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── S3 / MinIO ────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET_MEDIA=charter-media
S3_BUCKET_ARCHIVE=charter-archive
S3_BUCKET_GATEWAY=charter-gateway

# ─── JWT ───────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Encryption ────────────────────────────────
ENCRYPTION_KEY=change-me-base64-32-bytes-long-key-here
INTEGRITY_HMAC_KEY=change-me-base64-32-bytes-long-key-here
# ─── Rate Limit ────────────────────────────────
RATE_LIMIT_ENABLED=true

# ─── Cron / Service Worker ─────────────────────
# Сервисный участник для K8s CronJob I.3.05.06 (psy-mood-aggregate-*).
#
# Создаётся / обновляется скриптом:
#   pnpm tsx scripts/ensure-psy-cron.ts <password>
#
# В K8s креды кладутся в Secret xartia-psy-cron:
#   kubectl create secret generic xartia-psy-cron \
#     --namespace xartia \
#     --from-literal=phone='...' \
#     --from-literal=password='...'
#
# В .env эти переменные нужны только для локальной отладки скрипта —
# сам CronJob использует переменные из K8s Secret.

# ─── Test fixtures (scripts/test-psy.ts) ───────
# UUID второго участника для роли психолога в /psy/sessions.
# Пусто → fallback: external_id 'А00001-2' → любой другой активный.
# Заполнить после `SELECT id FROM participants WHERE external_id = 'А00001-2';`
TEST_PSYCHOLOGIST_ID=

# ─── Feature Flags ─────────────────────────────
FEATURE_CHAT=true
FEATURE_VIDEO_CALL=true
FEATURE_OFFLINE_MODE=false

# ─── Webhooks (V.6, V.7) ──────────────────────
# Разрешить HTTP и приватные IP для webhook-URL.
# ТОЛЬКО ДЛЯ DEV (иначе локальный mock-сервер не пройдёт SSRF-защиту).
# В prod — оставить false или удалить.
ALLOW_PRIVATE_WEBHOOKS=false

# ─── Cron / Service Worker (Webhooks) ─────────
# Сервисный участник для K8s CronJob I.3.05.08 (webhooks-process-retries).
# Создаётся / обновляется скриптом:
#   pnpm tsx scripts/ensure-webhooks-cron.ts <password>
WEBHOOKS_CRON_PHONE=+70000000003
WEBHOOKS_CRON_EXTERNAL_ID=В90003-01
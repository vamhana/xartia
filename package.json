{
  "name": "xartia",
  "version": "0.0.01",
  "private": true,
  "description": "XartIA Charter 5.0 — Civilization OS",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <26",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:worker": "node dist/worker/index.js",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:dry": "tsx scripts/migrate.ts -- --dry-run",
    "db:reset": "tsx scripts/reset.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "ensure:architect": "tsx scripts/ensure-architect.ts",
    "login:architect": "tsx scripts/login-architect.ts",
    "token:show": "tsx scripts/login-architect.ts -- --print",
    "token:refresh": "tsx scripts/login-architect.ts -- --force"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.650.0",
    "@aws-sdk/s3-presigned-post": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.650.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.1.0",
    "@fastify/websocket": "^11.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "argon2": "^0.41.1",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.5",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.1",
    "jose": "^5.10.0",
    "leaflet": "^1.9.4",
    "nanoid": "^5.0.7",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-grid-layout": "^2.3.0",
    "react-hook-form": "^7.89.0",
    "react-leaflet": "^5.0.0",
    "react-resizable": "^4.0.2",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tsx": "^4.19.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^2.1.2",

    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",

    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vite": "^8.3.4",
    "vitest": "^2.1.2",
    "ws": "^8.22.0"
  }
}
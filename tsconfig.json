{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "outDir": "./dist",
    "rootDir": "./src",
    "noImplicitReturns": true,
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["src/core/*"],
      "@lib/*": ["src/lib/*"],
      "@api/*": ["src/api/*"],
      "@security/*": ["src/security/*"],
      "@ws/*": ["src/ws/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests", "src/web"]
}

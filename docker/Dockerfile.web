# docker/Dockerfile.web — multi-stage: Vite build → nginx serve.
# Сборка: docker build -f docker/Dockerfile.web -t xartia-web:latest .

# ─── Stage 1: build ───────────────────────────────────────────
FROM node:22-alpine AS build
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@9 --activate

# Зависимости (нужен --frozen-lockfile, devDeps тоже — vite)
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Исходники web
COPY tsconfig.base.json tsconfig.web.json vite.config.ts ./
COPY src/web ./src/web

# Vite build → dist/web (см. vite.config.ts: build.outDir)
RUN pnpm exec vite build

# ─── Stage 2: serve ───────────────────────────────────────────
FROM nginxinc/nginx-unprivileged:1.27-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/web /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1